{
  "name": "northline-booking",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --env-file=.env --watch server/index.mjs",
    "start": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . && tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run tests/availability.test.ts tests/frontend.test.tsx tests/gateway.test.ts",
    "test:api": "vitest run tests/api.test.ts",
    "db:migrate": "node server/migrate.mjs",
    "smoke:production": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "pino": "^9.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.4",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.7",
    "vitest": "^4.1.11",
    "@types/luxon": "^3.7.1"
  }
}
